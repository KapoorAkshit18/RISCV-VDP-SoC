---
config:
  theme: mc
---
flowchart TB
    %% Compact, publication-ready view matching tpu_ral.mmd aesthetic
    classDef architecture fill:#E8EEF5,stroke:#355C7D,stroke-width:1.5px,color:#1F2937,font-weight:bold
    classDef rtl fill:#E3EDF7,stroke:#2F6690,stroke-width:1.25px,color:#1F2937
    classDef simulation fill:#E6F1F5,stroke:#3F7C85,stroke-width:1.25px,color:#1F2937
    classDef formal fill:#EAF3EA,stroke:#52796F,stroke-width:1.25px,color:#1F2937
    classDef analog fill:#FEF3C7,stroke:#D97706,stroke-width:1.25px,color:#1F2937

    RBLK["Sensor Register Block<br/>Base: 0x0001_2000"]
    MAP["Default Map<br/>Little-endian; 32-bit bus"]
    RBLK ==> MAP

    subgraph REGS["MMIO Register Map (RO)"]
        direction LR
        BATT_PCT["BATT_PERCENT<br/>0x00; RO 8-bit"]
        BATT_VOLT["BATT_VOLTAGE<br/>0x04; RO 16-bit mV"]
        TEMP["TEMPERATURE<br/>0x08; RO 16-bit signed"]
        STATUS["SENSOR_STATUS<br/>0x0C; Alarm & Low flags"]
    end
    MAP ==> REGS

    subgraph RNM["RNM Mixed-Signal Model"]
        direction LR
        PHYS["Physical Stimulus<br/>Temp: -40 to 125°C<br/>Batt: 0 to 100%"]
        ANALOG["Analog Front-End<br/>temp_sensor_rnm<br/>adc_rnm (Noise model)"]
        SYNC["2-FF Synchronizer<br/>batt_pct_sync<br/>temp_sync"]
        PHYS ==> ANALOG
        ANALOG ==> SYNC
    end

    subgraph MON_SEC["Monitor & Correlation"]
        direction LR
        SMON["Sensor Monitor<br/>Subscribes Native Bus"]
        CORR["Python RNM Correlator<br/>rnm_correlation.py"]
        EVT["Completion Detector<br/>DEBUG_MARKER: 0x12A8"]
        SMON --> CORR
        SMON --> EVT
    end

    subgraph UVM_CHECKS["Active & Directed Tests"]
        direction LR
        RAL_CHK["RAL Frontdoor Reads<br/>soc_active_sensor_ral_test"]
        CRN_CHK["Corner & Boundary<br/>-40°C, 125°C, 0%, 100%<br/>Thresholds: 15%, 80.0°C"]
        RO_CHK["Protocol Enforcement<br/>RO Write-ignore<br/>Unmapped 0x2800=0"]
    end

    SYNC ==> REGS
    REGS -. "Native Bus Reads" .-> MON_SEC
    MAP -. "RAL & Stimulus" .-> UVM_CHECKS

    class RBLK,MAP architecture
    class BATT_PCT,BATT_VOLT,TEMP,STATUS rtl
    class SMON,CORR,EVT simulation
    class RAL_CHK,CRN_CHK,RO_CHK formal
    class PHYS,ANALOG,SYNC analog
