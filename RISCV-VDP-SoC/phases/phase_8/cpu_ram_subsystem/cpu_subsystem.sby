[options]
mode bmc
depth 10

[engines]
smtbmc z3

[script]
read_verilog -formal riscv.v
read_verilog -formal riscv_wrapper.v
read_verilog -formal cpu_bus_adapter.v
read_verilog -formal soc_mem_interconnect.v
read_verilog -formal soc_ram.v
read_verilog -formal cpu_ram_subsystem.v
read_verilog -sv cpu_ram_subsystem_formal.sv
prep -top cpu_ram_subsystem_formal

