graph TB
    %% --- CLASS DEFINITIONS (Publication Palette) ---
    classDef blockStyle  fill:#0F172A,stroke:#020617,stroke-width:2px,color:#FFFFFF,font-weight:bold
    classDef mapStyle    fill:#334155,stroke:#1E293B,stroke-width:1.5px,color:#FFFFFF,font-weight:bold
    classDef regStyle    fill:#F1F5F9,stroke:#64748B,stroke-width:1.5px,color:#0F172A,font-weight:bold
    classDef monStyle    fill:#0284C7,stroke:#0369A1,stroke-width:1.5px,color:#FFFFFF,font-weight:bold
    classDef predStyle   fill:#D97706,stroke:#B45309,stroke-width:1.5px,color:#FFFFFF,font-weight:bold
    classDef mirrorStyle fill:#059669,stroke:#047857,stroke-width:1.5px,color:#FFFFFF,font-weight:bold
    classDef groupStyle  fill:#F8FAFC,stroke:#CBD5E1,stroke-width:1.5px,color:#334155,font-weight:bold

    %% --- MAIN REG BLOCK ---
    RBLK["sensor_reg_block<br/>(Base: 0x0001_2000)"]

    %% --- ADDRESS MAP ---
    MAP["default_map<br/>(UVM_LITTLE_ENDIAN | bus_width=4 Bytes)"]

    %% --- REGISTER DEFINITIONS ---
    subgraph REGS ["REGISTER MODEL DEFINITIONS"]
        direction TB
        R0["BATTERY_PERCENT<br/>Offset: 0x00 | Access: RO"]
        R1["BATTERY_VOLTAGE<br/>Offset: 0x04 | Access: RO"]
        R2["TEMPERATURE<br/>Offset: 0x08 | Access: RO"]
        R0 ~~~ R1 ~~~ R2
    end

    %% --- PREDICTOR & MIRROR PATH ---
    subgraph PRED_SUB ["UVM RAL PREDICTION & MIRROR UPDATE"]
        direction TB
        MON_IN["Native Bus Monitor<br/>(Observes Bus Transactions)"]
        PRED2["soc_reg_predictor<br/>(uvm_reg_predictor)"]
        MIRROR["RAL Desired &amp; Mirrored Value<br/>(uvm_reg_field :: m_mirrored)"]
        MON_IN ==>|"Bus Transaction (uvm_reg_bus_op)"| PRED2
        PRED2 ==>|"Update Mirror State"| MIRROR
    end

    %% --- HIERARCHICAL & PREDICTION CONNECTIONS ---
    RBLK ==> MAP
    MAP ==> REGS
    RBLK -.->|"Instantiates Subsystem"| PRED_SUB
    MIRROR -.->|"Reflects Hardware State"| REGS

    %% --- CLASS ASSIGNMENTS ---
    class RBLK blockStyle
    class MAP mapStyle
    class R0,R1,R2 regStyle
    class MON_IN monStyle
    class PRED2 predStyle
    class MIRROR mirrorStyle
    class REGS,PRED_SUB groupStyle