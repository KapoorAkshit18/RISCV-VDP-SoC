graph TB
    %% --- CLASS DEFINITIONS (Original Conversation Palette) ---
    classDef topStyle     fill:#34495E,stroke:#2C3E50,stroke-width:2px,color:#FFFFFF,font-weight:bold
    classDef uvmStyle     fill:#2C3E50,stroke:#2C3E50,stroke-width:1.5px,color:#FFFFFF,font-weight:bold
    classDef rtlStyle     fill:#4A5568,stroke:#4A5568,stroke-width:2px,color:#FFFFFF,font-weight:bold
    classDef provenStyle  fill:#E2E8F0,stroke:#94A3B8,stroke-width:1.5px,color:#2C3E50,font-weight:bold
    classDef timeoutStyle fill:#4A5568,stroke:#4A5568,stroke-width:1.5px,color:#FFFFFF,font-weight:bold
    classDef mutantStyle  fill:#D97706,stroke:#B45309,stroke-width:1.5px,color:#FFFFFF,font-weight:bold
    classDef ifaceStyle   fill:#F8FAFC,stroke:#94A3B8,stroke-width:1.5px,stroke-dasharray:3 2,color:#4A5568,font-weight:bold
    classDef groupStyle   fill:#F8FAFC,stroke:#94A3B8,stroke-width:1.5px,color:#4A5568,font-weight:bold

    %% --- DYNAMIC VERIFICATION PLANE ---
    subgraph DVP ["Dynamic Verification Plane — Phase 5 (UVM + RNM)"]
        direction TB

        TEST["soc_tpu_test<br/><br/>(UVM Test Sequence)"]

        subgraph ENV ["soc_env Engine"]
            direction TB

            subgraph AGT ["Native Bus Agent (Active)"]
                direction LR
                SEQ["Sequence"] --> SQCR["Sequencer"] --> DRV["Driver"]
            end

            RAL["RAL Model: soc_reg_block<br/><br/>(GPIO · RF · Sensor · VDP · TPU)"]

            PRED["RAL Predictor<br/><br/>(Mirror on observed bus Tx)"]

            MON["Native Bus Monitor"]

            TPUMON["TPU Monitor<br/><br/>(AXI-Stream Snoop)"]

            SENMON["Sensor Monitor<br/><br/>(RNM Correlation)"]

            TPUSCB["TPU Scoreboard<br/><br/>(C DPI Ref Model)"]

            COV["Functional Coverage"]
        end

        TEST ==> ENV
        MON -.-> PRED -.-> RAL
        MON -.-> TPUSCB & COV & SENMON
        TPUMON -.-> TPUSCB
    end

    %% --- VIRTUAL INTERFACE BOUNDARY ---
    VIF{{"SoC Verification Interface:<br/><br/>soc_native_if · tpu_debug_if"}}

    %% --- HARDWARE DESIGN PLANE ---
    subgraph HDP ["Hardware Design Plane — DUT (cpu_soc_ram_top)"]
        direction LR

        CPU2["PicoRV32<br/><br/>* Bus Adapter"]

        IC2["SoC Interconnect<br/><br/>Address Decoder"]

        PER2["Peripherals Block<br/><br/>RAM · GPIO · RF · Sensor · VDP · TPU"]

        CPU2 ==> IC2 ==> PER2
    end

    %% --- STATIC VERIFICATION PLANE ---
    subgraph SVP ["Static Verification Plane — Phase 8 (Formal BMC)"]
        direction TB

        SOLVER["SymbiYosys / Z3 Engine<br/><br/>(smtbmc)"]

        subgraph PASS_T ["Proven Targets [PASS]"]
            direction LR

            CPU_P["CPU/RAM Bus<br/><br/>ABS_A01"]

            SEN_P["Sensor Status<br/><br/>SEN_A01–A04"]

            AXI_P["AXI-Stream Interface<br/><br/>P01–P04 · P06"]
        end

        subgraph TIMEOUT_T ["Intractable Targets [TIMEOUT]"]
            direction LR

            IC_T["Interconnect<br/><br/>IC_A01–A05"]

            TPU_T["Full TPU<br/><br/>TPU_A01–A04"]

            P05_T["MMIO START Path<br/><br/>P05"]
        end

        SOLVER ==> PASS_T & TIMEOUT_T
    end

    %% --- MUTATION VERIFICATION PLANE ---
    subgraph MVP ["Mutation Verification Plane — Phase 7"]
        direction LR